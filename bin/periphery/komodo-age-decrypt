#!/bin/bash
#
# komodo-age-decrypt <env-file> <output-file>
#
# Runs as a stack's pre_deploy (AzScep deployment-script ADR 0008). Reads every
# AGE_<NAME>=<base64 age ciphertext> line from the env file Komodo wrote,
# decrypts each with this server's age identity, and writes NAME='value' lines
# to the output file with mode 0600, replacing it only when every secret
# decrypted. Any failure exits non-zero so the deploy stops before compose up,
# and leaves any previous output file untouched.
#
# The identity is read from $KOMODO_AGE_IDENTITY (default /config/age.key),
# a read-only mount of the server's root-only key file. Output names secrets
# but never prints a value.

set -uo pipefail
umask 077

readonly IDENTITY="${KOMODO_AGE_IDENTITY:-/config/age.key}"
readonly NAME_PATTERN='^[A-Z_][A-Z0-9_]*$'

fail() {
  echo "komodo-age-decrypt: $*" >&2
  exit 1
}

[ $# -eq 2 ] || fail "usage: komodo-age-decrypt <env-file> <output-file>"
readonly ENV_FILE="$1"
readonly OUTPUT="$2"

[ -f "$ENV_FILE" ] && [ -r "$ENV_FILE" ] || fail "cannot read env file $ENV_FILE"
[ ! -d "$OUTPUT" ] || fail "output $OUTPUT is a directory"
[ -f "$IDENTITY" ] && [ -r "$IDENTITY" ] || fail "cannot read age identity $IDENTITY"
case "$(stat -L -c '%a' "$IDENTITY")" in
  400 | 600) ;;
  *) fail "age identity $IDENTITY is readable by group or others; chmod 600 it" ;;
esac

WORK="$(mktemp -d "$(dirname -- "$OUTPUT")/.komodo-age-decrypt.XXXXXX")" || fail "cannot create a temporary directory beside $OUTPUT"
readonly WORK
trap 'rm -rf -- "$WORK"' EXIT
trap 'exit 1' INT TERM HUP
: > "$WORK/out" || fail "cannot write a temporary file beside $OUTPUT"

# Plain settings in the env file, so a secret cannot be silently overridden by
# a setting of the same name (Komodo passes its env file last, so it wins).
declare -A settings=() seen=()
while IFS= read -r line || [ -n "$line" ]; do
  line="${line%$'\r'}"
  case "$line" in
    AGE_*) ;;
    export\ *=*) key="${line#export }"; settings["${key%%=*}"]=1 ;;
    [A-Za-z_]*=*) settings["${line%%=*}"]=1 ;;
  esac
done < "$ENV_FILE"

count=0
while IFS= read -r line || [ -n "$line" ]; do
  line="${line%$'\r'}"
  case "$line" in
    AGE_*) ;;
    *) continue ;;
  esac
  [[ "$line" == *=* ]] || fail "line starting AGE_ has no '='"
  name="${line%%=*}"
  name="${name#AGE_}"
  ciphertext="${line#*=}"
  [[ "$name" =~ $NAME_PATTERN ]] || fail "secret name AGE_$name is not upper-case letters, digits, and underscores"
  [ -z "${seen[$name]:-}" ] || fail "secret $name is listed twice"
  seen["$name"]=1
  [ -z "${settings[$name]:-}" ] || fail "secret $name is also set as a plain setting, which would override it"
  # Compose interpolates from its own environment before any env file.
  [ -z "${!name+set}" ] || fail "secret $name is also set in Periphery's environment, which would override it"
  [ -n "$ciphertext" ] || fail "secret $name has no ciphertext"

  if ! printf '%s' "$ciphertext" | base64 -d > "$WORK/cipher" 2> "$WORK/err"; then
    fail "secret $name: ciphertext is not valid base64"
  fi
  # The plaintext stays in memory, never on disk: each check decrypts again.
  if ! size="$(age -d -i "$IDENTITY" "$WORK/cipher" 2> "$WORK/err" | wc -c)"; then
    fail "secret $name: age could not decrypt it ($(head -n 1 "$WORK/err" | head -c 300))"
  fi
  # Line breaks, NUL, and other control characters cannot be written as one
  # env-file line; refuse rather than change the value.
  printable="$(age -d -i "$IDENTITY" "$WORK/cipher" 2> /dev/null | LC_ALL=C tr -d '\000-\037\177' | wc -c)" ||
    fail "secret $name: age could not decrypt it"
  [ "$size" -eq "$printable" ] || fail "secret $name contains a line break or control character, which an env file cannot hold"
  value="$(age -d -i "$IDENTITY" "$WORK/cipher" 2> /dev/null)" || fail "secret $name: age could not decrypt it"
  # Single quotes keep the value literal in compose env files: no ${...}
  # interpolation, and a backslash is literal except before a quote. So a value
  # holding a single quote, or ending in a backslash (which would escape the
  # closing quote, and compose would then print the value in its parse error),
  # cannot be written.
  case "$value" in
    *"'"*) fail "secret $name contains a single quote, which an env file cannot hold literally" ;;
    *\\) fail "secret $name ends in a backslash, which an env file cannot hold literally" ;;
  esac
  printf "%s='%s'\n" "$name" "$value" >> "$WORK/out" || fail "cannot write $name to a temporary file"
  rm -f -- "$WORK/cipher"
  echo "decrypted $name"
  count=$((count + 1))
done < "$ENV_FILE"

chmod 600 "$WORK/out" || fail "cannot set mode 600 on a temporary file"
mv -f -- "$WORK/out" "$OUTPUT" || fail "cannot write $OUTPUT"
echo "wrote $count secret(s) to $OUTPUT"
